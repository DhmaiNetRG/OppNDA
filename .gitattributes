# Auto detect text files and perform LF normalization
* text=auto

# Force LF for source files to prevent CRLF/LF warnings
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.wkt binary
*.jar binary
